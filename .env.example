# OpenWeatherMap API key (covers both Weather API and Air Pollution API)
# Sign up free at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your_openweather_api_key_here

# OpenAI API key (for AI health advisory agent)
# Get one at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# PostgreSQL connection
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=vayu
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password_here

# Optional: OpenAQ API key (basic access is free without a key)
# OPENAQ_API_KEY=
